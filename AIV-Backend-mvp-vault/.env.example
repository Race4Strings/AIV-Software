# Database
DATABASE_URL=postgresql+asyncpg://admin:securepassword@localhost:5433/nestdb
DATABASE_URL_SYNC=postgresql://admin:securepassword@localhost:5433/nestdb

# Redis
REDIS_URL=redis://localhost:6380

# Session
SESSION_SECRET=your-super-secret-key-change-in-production
SESSION_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Email (MailHog for development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@aiv.chat

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aiv-uploads
MINIO_SECURE=false

# AI
GOOGLE_GENAI_API_KEY=your-gemini-api-key

# Polygon Blockchain (Amoy Testnet)
