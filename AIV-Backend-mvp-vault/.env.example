# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aiv:aiv_password@localhost:5432/aiv_db

# ── Redis ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Session ───────────────────────────────────────
SESSION_SECRET=change-me-in-production
SESSION_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Cookies ───────────────────────────────────────
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ── Email (Resend for production, SMTP for dev) ──
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@aiv.chat

# ── MinIO / S3 Storage ───────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aiv-uploads
MINIO_SECURE=false

# ── Stripe (Payments) ────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PLATFORM_FEE_PRICE_ID=price_...

# ── Dropbox Sign (E-Signatures) ──────────────────
DROPBOX_SIGN_API_KEY=

# ── Polygon Blockchain ───────────────────────────
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_PRIVATE_KEY=
CERT_CONTRACT_ADDRESS=

# ── ALCM API ─────────────────────────────────────
ALCM_API_URL=http://localhost:8001
ALCM_API_TIMEOUT=30
ALCM_AUTH_TOKEN=dev-alcm-token-change-in-production

# ── AI Providers ─────────────────────────────────
GOOGLE_GENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# ── URLs ──────────────────────────────────────────
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3001

# ── Dev Mode ──────────────────────────────────────
DEV_MODE=true
